{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "LinkedInServiceEndpointConfiguration": {
    "BaseUrl": "https://api.linkedin.com/v2",
    "Endpoints": {
      "JobRequisitions": "/[JOBREQURL]",
      "IntegrationEnabled": "/[ATSDETAILS]"
    },
    "secrets": {
      "ClientId": "ClientId",
      "ClientSecret": "ClientSecret"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "ConnString"
  },
  "RabbitMq": {
    "HostName": "Rabbit.Host",
    "QueueName": "Rabbit.Event",
    "UserName": "Rabbit.User",
    "Password": "Rabbit.Password"
  }
}
